[Unit]
Description=Cloudflare Tunnel (mando webhook ingress → /linear, /webhook)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/cloudflared --config {{ cloudflared_config_dir }}/config.yml tunnel run
Restart=on-failure
RestartSec=5s
User=root
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
