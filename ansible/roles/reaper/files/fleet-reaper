#!/usr/bin/env bash
# fleet-reaper — host-side safety net that kills Firecracker microVMs which have
# exceeded their absolute lifetime or gone silent, and cleans up after VMs that died on
# their own. PLAN §7.6, invariant I8.
#
# It NEVER touches workspace volumes — a reaped VM's PR may still be open; only the
# transient run-state dir under FLEET_VM_STATE_DIR and the VM's tap device are removed.
#
# Per-VM state (written by fleet-agent) lives at $FLEET_VM_STATE_DIR/<session_id>/:
#   vm.json          full record (includes the tap name)
#   firecracker.pid  pid of the Firecracker process
#   started_at       epoch seconds of launch (else ps elapsed time is used)
#   heartbeat        optional — mtime refreshed while the VM is healthy
#
# This is the host safety net only; Temporal + the reconciliation loop are authoritative.
set -euo pipefail

STATE_DIR="${FLEET_VM_STATE_DIR:-/run/fleet/vms}"
MAX_LIFETIME="${FLEET_MAX_LIFETIME:-21600}"          # 6h
HEARTBEAT_TIMEOUT="${FLEET_HEARTBEAT_TIMEOUT:-600}"  # 10m
TERM_GRACE="${FLEET_TERM_GRACE:-10}"
ORPHAN_GRACE="${FLEET_ORPHAN_GRACE:-120}"            # min age before killing a state-less VM

log() { echo "fleet-reaper: $*"; }

# reap <pid> <session_id> <reason>
reap() {
  local pid="$1" sid="$2" reason="$3" i
  log "reaping ${sid} pid=${pid}: ${reason}"
  kill -TERM "${pid}" 2>/dev/null || true
  for ((i = 0; i < TERM_GRACE; i++)); do
    kill -0 "${pid}" 2>/dev/null || break
    sleep 1
  done
  if kill -0 "${pid}" 2>/dev/null; then
    kill -KILL "${pid}" 2>/dev/null || true
  fi
}

# del_tap <vmdir> — delete the VM's tap device (from vm.json). A VM that died on its own
# leaves its tap behind; stale taps collide on the next launch (same /30), so remove it.
del_tap() {
  local vmdir="$1" tap=""
  if [ -f "${vmdir}vm.json" ]; then
    tap="$(jq -r '.tap // empty' "${vmdir}vm.json" 2>/dev/null || true)"
  fi
  if [ -n "${tap}" ] && ip link show "${tap}" >/dev/null 2>&1; then
    ip link del "${tap}" 2>/dev/null && log "deleted tap ${tap}" || true
  fi
}

# remove_vm <vmdir> — delete the tap and the transient run-state dir. NEVER the workspace.
remove_vm() {
  del_tap "$1"
  rm -rf "$1"
}

[ -d "${STATE_DIR}" ] || exit 0
now="$(date +%s)"

shopt -s nullglob
for vmdir in "${STATE_DIR}"/*/; do
  sid="$(basename "${vmdir}")"
  pidfile="${vmdir}firecracker.pid"
  [ -f "${pidfile}" ] || continue
  pid="$(cat "${pidfile}" 2>/dev/null || true)"
  if [ -z "${pid}" ]; then
    remove_vm "${vmdir}"
    continue
  fi

  # Already gone: clear stale bookkeeping + tap (workspace untouched).
  if ! kill -0 "${pid}" 2>/dev/null; then
    log "clearing stale state for ${sid} (pid ${pid} not running)"
    remove_vm "${vmdir}"
    continue
  fi

  # Guard against PID reuse: only ever act on an actual Firecracker process. /proc/<pid>/comm is
  # truncated to 15 chars, so the versioned binary (firecracker-v1.16.1-x86_64) shows as
  # "firecracker-v1." — prefix-match, or a live VM is mistaken for a reused pid and its tap/state
  # get stripped out from under it (severing its network → false "dead").
  comm="$(cat "/proc/${pid}/comm" 2>/dev/null || true)"
  case "${comm}" in
  firecracker*) ;;
  *)
    log "pid ${pid} for ${sid} is '${comm}', not firecracker — dropping stale state"
    remove_vm "${vmdir}"
    continue
    ;;
  esac

  reason=""

  # Absolute lifetime.
  if [ -f "${vmdir}started_at" ]; then
    start="$(cat "${vmdir}started_at" 2>/dev/null || echo "${now}")"
    age=$((now - start))
  else
    age="$(ps -o etimes= -p "${pid}" 2>/dev/null | tr -d ' ')"
    age="${age:-0}"
  fi
  if [ "${age}" -ge "${MAX_LIFETIME}" ]; then
    reason="max-lifetime age=${age}s"
  fi

  # Stale heartbeat (only when a heartbeat file exists).
  if [ -z "${reason}" ] && [ -f "${vmdir}heartbeat" ]; then
    hb="$(stat -c %Y "${vmdir}heartbeat" 2>/dev/null || echo "${now}")"
    idle=$((now - hb))
    if [ "${idle}" -ge "${HEARTBEAT_TIMEOUT}" ]; then
      reason="stale-heartbeat idle=${idle}s"
    fi
  fi

  if [ -n "${reason}" ]; then
    reap "${pid}" "${sid}" "${reason}"
    remove_vm "${vmdir}" # transient state + tap only — NOT the workspace volume (§7.6)
  fi
done

# Sweep orphan Firecracker processes whose VM state dir is gone. A guest that wedges (never
# reaches its clean power-off) can outlive `DestroyVM`, which removes the state dir but may not
# kill a process stuck in uninterruptible I/O. Nothing else catches a process with no state
# dir — the main loop and the reconciler are both state-driven — so this is the last net.
# Match on the stable api-sock marker (Firecracker's comm is truncated to "firecracker-v1.").
# The ORPHAN_GRACE avoids the launch race: fleet-agent starts Firecracker before it persists
# the state dir, so a just-launched VM briefly has a live process and no dir.
for pid in $(pgrep -f -- '--api-sock /firecracker.socket' 2>/dev/null || true); do
  cl="$(tr '\0' ' ' < "/proc/${pid}/cmdline" 2>/dev/null || true)"
  case "${cl}" in *firecracker*) ;; *) continue ;; esac
  jid="$(printf '%s' "${cl}" | grep -oE -- '--id [^ ]+' | awk '{print $2}')"
  [ -n "${jid}" ] || continue
  sid="s_${jid#s-}" # jailer id "s-XXXX" ← session id "s_XXXX" (jailer forbids underscores)
  [ -d "${STATE_DIR}/${sid}" ] && continue # fleet-agent still tracks it — leave it
  age="$(ps -o etimes= -p "${pid}" 2>/dev/null | tr -d ' ')"
  age="${age:-0}"
  [ "${age}" -lt "${ORPHAN_GRACE}" ] && continue # too young — may be mid-launch
  reap "${pid}" "${sid}" "orphan firecracker (no state dir) age=${age}s"
  tap="tap${sid:2:12}" # TapName(): "tap" + first 12 of the id suffix
  if ip link show "${tap}" >/dev/null 2>&1; then
    ip link del "${tap}" 2>/dev/null && log "deleted orphan tap ${tap}" || true
  fi
done

# Sweep orphan jailer logs: fleet-agent captures jailer/firecracker output to a top-level
# jailer-<sid>.log (not inside the per-VM dir), so it outlives a removed VM. Drop any whose
# session state dir is gone.
for lf in "${STATE_DIR}"/jailer-*.log; do
  [ -e "${lf}" ] || continue
  sid="$(basename "${lf}" .log)"
  sid="${sid#jailer-}"
  [ -d "${STATE_DIR}/${sid}" ] || rm -f "${lf}"
done
