#!/usr/sbin/nft -f
# {{ ansible_managed }}
#
# Guest egress policy — PLAN §7.4, invariants I2 (no inbound to guests) and I3 (no
# guest-to-guest). Single-machine build: every service a guest may reach is host-local, on
# the anchor address {{ fleet_host_gw_addr }}. Deny-by-default for the guest tap class
# ("{{ fleet_guest_iface_prefix }}*"): a guest may reach ONLY
#   - the host resolver     ({{ fleet_host_gw_addr }} udp/tcp 53)
#   - the host egress proxy ({{ fleet_host_gw_addr }} tcp {{ fleet_egress_proxy_port }})
#   - the host NATS server  ({{ fleet_host_gw_addr }} tcp {{ fleet_nats_port }})
# Everything else — other guests, the host's sensitive ports (incl. Temporal 7233 and the
# mando-agent API), the wider internet — is dropped and counted.
#
# Because all reachable services are host-local (input chain), guests never forward anywhere:
# the forward chain is default-drop with no permit rules, and no NAT is needed. The input
# chain policy is 'accept' so this table does not govern the host's own management inbound;
# guest inbound is denied by the explicit tap catch-all drop.
#
# Only "table inet fleet" is (re)defined, non-destructively, so a reload leaves other tables
# intact — including the separate per-tap table mando-agent adds at launch.

add table inet fleet
delete table inet fleet

table inet fleet {
    set blocked_host_ports {
        type inet_service
        elements = { {{ fleet_blocked_host_ports | join(', ') }} }
    }

    chain input {
        type filter hook input priority filter; policy accept;

        iif "lo" accept
        ct state established,related accept

        # Host-local services a guest may reach, on the anchor address only.
        iifname "{{ fleet_guest_iface_prefix }}*" ip daddr {{ fleet_host_gw_addr }} udp dport 53 accept
        iifname "{{ fleet_guest_iface_prefix }}*" ip daddr {{ fleet_host_gw_addr }} tcp dport 53 accept
        iifname "{{ fleet_guest_iface_prefix }}*" ip daddr {{ fleet_host_gw_addr }} tcp dport {{ fleet_egress_proxy_port }} accept
        iifname "{{ fleet_guest_iface_prefix }}*" ip daddr {{ fleet_host_gw_addr }} tcp dport {{ fleet_nats_port }} accept

        # High-visibility drops for sensitive host ports reachable from a guest on any other
        # host address (the anchor accepts above already whitelisted what is allowed).
        iifname "{{ fleet_guest_iface_prefix }}*" tcp dport @blocked_host_ports counter drop

        # Deny-by-default for the guest tap class.
        iifname "{{ fleet_guest_iface_prefix }}*" counter drop
    }

    chain forward {
        type filter hook forward priority filter; policy drop;

        ct state established,related accept

        # No guest-to-guest lateral movement (I3).
        iifname "{{ fleet_guest_iface_prefix }}*" oifname "{{ fleet_guest_iface_prefix }}*" counter drop

        # Deny-by-default for everything else forwarded from a guest.
        iifname "{{ fleet_guest_iface_prefix }}*" counter drop
    }

    chain output {
        type filter hook output priority filter; policy accept;
    }
}
