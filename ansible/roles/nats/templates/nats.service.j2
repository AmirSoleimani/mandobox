# {{ ansible_managed }}
[Unit]
Description=NATS server (single-machine control plane)
After=network-online.target fleet-net-anchor.service
Wants=network-online.target fleet-net-anchor.service

[Service]
Type=exec
User={{ nats_user }}
ExecStart={{ nats_bin }} -c {{ nats_conf }}
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
